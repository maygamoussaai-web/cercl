{
  "expo": {
    "owner": "moussmasss-team",
    "name": "CERCL",
    "slug": "cercl",
    "scheme": "cercl",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B10",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cercl.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "CERCL a besoin d'accéder à tes photos pour changer ta photo de profil ou l'image d'un Cercle."
      }
    },
    "android": {
      "package": "com.cercl.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CERCL a besoin d'accéder à tes photos pour changer ta photo de profil ou l'image d'un Cercle."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a69a722e-8e22-4c89-8890-7db33eaa010a"
      }
    }
  }
}
